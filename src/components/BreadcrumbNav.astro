---
import type { SupportedLocale } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';

export interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;

const breadcrumbLabels: Record<SupportedLocale, { home: string; current: string }> = {
  en: { home: 'Home', current: 'Bulk Image Resizer' },
  es: { home: 'Inicio', current: 'Redimensionador de Imágenes' },
  pt: { home: 'Início', current: 'Redimensionador de Imagens' },
  de: { home: 'Startseite', current: 'Stapel-Bildverkleinerer' },
  fr: { home: 'Accueil', current: "Redimensionneur d'Images" },
  ja: { home: 'ホーム', current: '一括画像リサイズ' },
};

const labels = breadcrumbLabels[locale] || breadcrumbLabels.en;
const siteUrl = 'https://bulkresize.github.io';
const currentHref = `${siteUrl}${Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/'}`;
---

<nav aria-label="Breadcrumb" class="mb-5 inline-flex items-center text-xs font-semibold text-[#4C4541]/75 dark:text-[#FCF0DA]/75">
  <ol class="flex items-center space-x-1.5 sm:space-x-2" itemscope itemtype="https://schema.org/BreadcrumbList">
    <!-- Breadcrumb Item 1: Home -->
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="flex items-center">
      <a
        href={getLocalizedPath('/', locale)}
        itemprop="item"
        class="hover:text-[#c68a25] dark:hover:text-[#F2C46A] transition flex items-center gap-1.5 p-1 rounded-md focus:outline-none focus:ring-1 focus:ring-[#F2C46A]"
      >
        <svg class="w-3.5 h-3.5 text-[#AEAC78]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span itemprop="name">{labels.home}</span>
      </a>
      <meta itemprop="position" content="1" />
      <span class="mx-1 text-[#4C4541]/40 dark:text-[#FCF0DA]/40 select-none" aria-hidden="true">/</span>
    </li>

    <!-- Breadcrumb Item 2: Current Page -->
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="flex items-center" aria-current="page">
      <span itemprop="name" class="font-bold text-[#4C4541] dark:text-[#FCF0DA] bg-[#AEAC78]/15 px-2 py-0.5 rounded-md">
        {labels.current}
      </span>
      <link itemprop="item" href={currentHref} />
      <meta itemprop="position" content="2" />
    </li>
  </ol>
</nav>
