---
import Layout from '../layouts/Layout.astro';
---

<Layout locale="en">
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4 py-16">
    <div class="w-20 h-20 rounded-3xl bg-indigo-50 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-black text-3xl mb-6 shadow-sm">
      404
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mb-3">
      Page Not Found
    </h1>
    <p class="text-slate-600 dark:text-slate-400 max-w-md mb-8 text-sm sm:text-base">
      The requested page could not be located. Head back to the bulk image resizer workspace to process your photos.
    </p>
    <a
      href="/"
      class="px-6 py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm shadow-md shadow-indigo-500/20 transition transform active:scale-95"
    >
      Return to Resizer
    </a>
  </div>
</Layout>
